---
// Hoja de vida imprimible, generada del mismo contenido que el sitio (src/data/profile.ts).
// Para obtener el PDF: abrir /cv y "Guardar como PDF" desde el diálogo de impresión.
import { profile } from '../data/profile';

const { contact } = profile;
const featured = profile.featured;
const title = `CV · ${profile.name}`;
const canonical = new URL('/cv', Astro.site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={`Hoja de vida de ${profile.name}, ${profile.headline}.`} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="toolbar">
      <a href="/">Volver al portafolio</a>
      <button type="button" id="imprimir">Guardar como PDF</button>
    </div>

    <main class="sheet">
      <header>
        <h1>{profile.name}</h1>
        <p class="headline">{profile.headline}</p>
        <p class="contact">
          <span>{profile.location}</span>
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
          <a href={contact.phoneHref}>{contact.phone}</a>
          <a href={contact.github.href}>{contact.github.label}</a>
          <a href={contact.linkedin.href}>{contact.linkedin.label}</a>
        </p>
      </header>

      <section>
        <h2>Perfil</h2>
        {profile.about.map((paragraph) => <p>{paragraph}</p>)}
      </section>

      <section>
        <h2>Experiencia</h2>
        {
          profile.experience.map((role) => (
            <article class="role">
              <div class="row">
                <h3>
                  {role.title}, {role.company}
                </h3>
                <p class="dates">
                  {role.start} – {role.end}
                </p>
              </div>
              {role.products && (
                <ul>
                  {role.products.map((product) => (
                    <li>
                      <strong>{product.title}.</strong> {product.description}
                      {product.usage && <span class="muted"> {product.usage}.</span>}
                      {product.stack.length > 0 && <span class="muted"> ({product.stack.join(', ')})</span>}
                    </li>
                  ))}
                </ul>
              )}
            </article>
          ))
        }
      </section>

      <section>
        <h2>Proyectos personales</h2>
        <article class="role">
          <div class="row">
            <h3>{featured.name}</h3>
            <p class="dates">{featured.repo.label}</p>
          </div>
          <p>{featured.summary}</p>
          <p class="muted">{featured.stack.join(', ')}</p>
        </article>
        {
          profile.projects.map((project) => (
            <article class="role">
              <div class="row">
                <h3>{project.name}</h3>
                <p class="dates">{project.repo.label}</p>
              </div>
              <p>{project.summary}</p>
              <p class="muted">{project.stack.join(', ')}</p>
            </article>
          ))
        }
      </section>

      <section>
        <h2>Habilidades</h2>
        <dl class="skills">
          {
            profile.skills.map((group) => (
              <>
                <dt>{group.category}</dt>
                <dd>{group.items.map((i) => (i.note ? `${i.name} (${i.note})` : i.name)).join(', ')}</dd>
              </>
            ))
          }
        </dl>
      </section>

      <section>
        <h2>Educación</h2>
        {
          profile.education.map((e) => (
            <article class="role">
              <div class="row">
                <h3>
                  {e.title}, {e.institution}
                </h3>
                <p class="dates">{e.status}</p>
              </div>
              {e.note && <p class="muted">{e.note}</p>}
            </article>
          ))
        }
      </section>
    </main>

    <script>
      document.getElementById('imprimir')?.addEventListener('click', () => window.print());
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Geist';
    font-style: normal;
    font-display: swap;
    font-weight: 100 900;
    src: url('/fonts/geist-latin-wght-normal.woff2') format('woff2-variations');
  }
  @font-face {
    font-family: 'Geist';
    font-style: normal;
    font-display: swap;
    font-weight: 100 900;
    src: url('/fonts/geist-latin-ext-wght-normal.woff2') format('woff2-variations');
    unicode-range: U+0100-02BA, U+1E00-1EFF;
  }
  :root {
    color-scheme: light;
    --ink: #142024;
    --muted: #4f6168;
    --line: #d5dee1;
    --accent: #1f5f7a;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: #eef2f3;
    color: var(--ink);
    font: 10.5pt/1.45 'Geist', ui-sans-serif, system-ui, sans-serif;
  }
  .toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 8.5in;
    margin: 0 auto;
    padding: 16px;
    font-size: 14px;
  }
  .toolbar a {
    color: var(--accent);
  }
  .toolbar button {
    font: inherit;
    font-weight: 600;
    color: #fff;
    background: var(--accent);
    border: 0;
    border-radius: 6px;
    padding: 8px 14px;
    cursor: pointer;
  }
  .toolbar :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .sheet {
    max-width: 8.5in;
    margin: 0 auto 48px;
    padding: 0.6in 0.65in;
    background: #fff;
    box-shadow: 0 1px 3px rgb(20 32 36 / 0.12);
  }
  h1 {
    margin: 0;
    font-size: 22pt;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .headline {
    margin: 4px 0 0;
    font-size: 11.5pt;
    color: var(--accent);
    font-weight: 500;
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 14px;
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 9.5pt;
  }
  .contact a {
    color: inherit;
    text-decoration: none;
  }
  section {
    margin-top: 16px;
  }
  h2 {
    margin: 0 0 6px;
    padding-bottom: 3px;
    border-bottom: 1px solid var(--line);
    font-size: 11.5pt;
    letter-spacing: -0.01em;
    color: var(--accent);
  }
  h3 {
    margin: 0;
    font-size: 10.5pt;
  }
  p {
    margin: 4px 0 0;
  }
  .role {
    margin-top: 8px;
    break-inside: avoid;
  }
  .row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: baseline;
  }
  .dates {
    margin: 0;
    flex-shrink: 0;
    color: var(--muted);
    font-size: 9.5pt;
  }
  ul {
    margin: 4px 0 0;
    padding-left: 16px;
  }
  li {
    margin-top: 3px;
  }
  .muted {
    color: var(--muted);
  }
  .skills {
    display: grid;
    grid-template-columns: 9.5em 1fr;
    gap: 3px 12px;
    margin: 0;
  }
  .skills dt {
    font-weight: 600;
  }
  .skills dd {
    margin: 0;
  }
  @media (max-width: 640px) {
    .sheet {
      padding: 24px 18px;
    }
    .row {
      flex-direction: column;
      gap: 0;
    }
    .skills {
      grid-template-columns: 1fr;
    }
  }
  @page {
    size: letter;
    margin: 0.5in;
  }
  @media print {
    body {
      background: #fff;
    }
    .toolbar {
      display: none;
    }
    .sheet {
      max-width: none;
      margin: 0;
      padding: 0;
      box-shadow: none;
    }
    a {
      color: inherit;
      text-decoration: none;
    }
    /* Dos páginas: un poco menos de aire entre bloques, sin achicar el texto. */
    section {
      margin-top: 12px;
    }
    .role {
      margin-top: 6px;
    }
    li {
      margin-top: 2px;
    }
    /* Un título nunca queda solo al pie de una página, ni una sección corta partida en dos. */
    h2 {
      break-after: avoid;
    }
    section:has(.skills),
    section:last-of-type {
      break-inside: avoid;
    }
  }
</style>
