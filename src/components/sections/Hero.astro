---
import { profile } from '../../data/profile';
import Icon from '../Icon.astro';

const status = [
  { key: 'ubicación', value: profile.location },
  { key: 'modalidad', value: profile.availability },
  { key: 'ahora', value: profile.currentRole },
  { key: 'stack', value: profile.mainStack },
];
---

<section id="inicio" aria-labelledby="hero-titulo" class="relative overflow-hidden pt-32 pb-20 sm:pt-40 sm:pb-28">
  <div
    class="dot-grid pointer-events-none absolute inset-0 -z-0 [mask-image:radial-gradient(ellipse_70%_60%_at_30%_40%,black,transparent)]"
    aria-hidden="true"
  >
  </div>

  <div class="container-page relative grid gap-14 lg:grid-cols-12 lg:items-end lg:gap-8">
    <div class="lg:col-span-8">
      <p class="font-mono text-sm text-accent">{profile.headline}</p>
      <h1
        id="hero-titulo"
        class="mt-5 text-[2.75rem] leading-[1.02] font-semibold tracking-[-0.04em] sm:text-7xl lg:text-[5.5rem]"
      >
        {profile.name}
      </h1>
      <p class="mt-7 max-w-[56ch] text-lg leading-relaxed text-muted sm:text-xl">
        {profile.valueProp}
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a href="#citara" class="btn btn-primary">Ver proyectos</a>
        <a href={profile.cv} class="btn btn-ghost" download>
          <Icon name="download" size={18} />
          Descargar CV
        </a>
        <span class="mx-1 hidden h-6 w-px bg-line sm:block" aria-hidden="true"></span>
        <a href={profile.contact.github.href} class="icon-link" rel="me noopener" target="_blank">
          <Icon name="github" />
          <span class="sr-only">GitHub (se abre en otra pestaña)</span>
        </a>
        <a href={profile.contact.linkedin.href} class="icon-link" rel="me noopener" target="_blank">
          <Icon name="linkedin" />
          <span class="sr-only">LinkedIn (se abre en otra pestaña)</span>
        </a>
      </div>
    </div>

    <!-- Único detalle tipo terminal del sitio: estado actual. -->
    <aside class="lg:col-span-4" aria-label="Estado actual">
      <div class="rounded-lg border border-line bg-surface font-mono text-[0.8125rem]">
        <div class="flex items-center gap-2 border-b border-line px-4 py-2.5 text-muted">
          <span class="inline-flex size-2 rounded-full bg-accent" aria-hidden="true"></span>
          <span>disponible</span>
        </div>
        <dl class="grid grid-cols-[6.5rem_1fr] gap-x-3 gap-y-2.5 px-4 py-4">
          {
            status.map((s) => (
              <>
                <dt class="text-muted">{s.key}</dt>
                <dd class="text-fg">{s.value}</dd>
              </>
            ))
          }
        </dl>
      </div>
    </aside>
  </div>
</section>
