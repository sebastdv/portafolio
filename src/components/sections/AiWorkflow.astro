---
import { profile } from '../../data/profile';
import Section from '../Section.astro';

const { intro, items } = profile.aiWorkflow;
---

<Section id="ia" title="Cómo trabajo con IA" lead={intro}>
  <ul class="grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2">
    {
      items.map((item) => (
        <li class="bg-bg p-6 sm:p-7">
          <h3 class="font-mono text-sm text-accent">{item.title}</h3>
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{item.body}</p>
        </li>
      ))
    }
  </ul>
</Section>
