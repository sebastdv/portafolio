---
import fs from 'node:fs';
import path from 'node:path';
import { profile } from '../../data/profile';
import Section from '../Section.astro';
import TagList from '../TagList.astro';
import Icon from '../Icon.astro';
import ArchitectureDiagram from '../ArchitectureDiagram.astro';

const p = profile.featured;
// Si ya pusiste la captura en public/, se muestra; si no, queda el espacio marcado.
const hasMedia = fs.existsSync(path.join(process.cwd(), 'public', p.media.src));
---

<Section id="citara" title={p.name} wide>
  <p slot="eyebrow" class="mb-4 font-mono text-sm text-accent">Proyecto destacado</p>

  <div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-7">
      <p class="max-w-[60ch] text-xl leading-relaxed sm:text-2xl sm:leading-snug">{p.summary}</p>
    </div>
    <dl class="grid content-start gap-5 text-[0.9375rem] lg:col-span-4 lg:col-start-9">
      <div>
        <dt class="font-mono text-xs text-muted">Estado</dt>
        <dd class="mt-1">{p.status}</dd>
      </div>
      <div>
        <dt class="font-mono text-xs text-muted">Repositorio</dt>
        <dd class="mt-1">
          <a href={p.repo.href} class="link inline-flex items-center gap-1.5" target="_blank" rel="noopener">
            {p.repo.label}
            <Icon name="external" size={15} />
            <span class="sr-only">(se abre en otra pestaña)</span>
          </a>
        </dd>
      </div>
      <div>
        <dt class="font-mono text-xs text-muted">Stack</dt>
        <dd class="mt-2"><TagList items={p.stack} label="Stack de citara" /></dd>
      </div>
    </dl>
  </div>

  <div class="mt-14">
    <h3 class="sr-only">Arquitectura</h3>
    <ArchitectureDiagram />
  </div>

  <div class="mt-14 grid gap-12 lg:grid-cols-12 lg:gap-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:col-span-7 lg:grid-cols-1 xl:grid-cols-2">
      <div>
        <h3 class="text-base font-semibold">Qué hace</h3>
        <ul class="mt-4 space-y-3 text-[0.9375rem] leading-relaxed text-muted">
          {
            p.features.map((f) => (
              <li class="flex gap-3">
                <span class="mt-[0.6rem] h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
                <span>{f}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3 class="text-base font-semibold">Cómo está construido</h3>
        <ul class="mt-4 space-y-3 text-[0.9375rem] leading-relaxed text-muted">
          {
            p.architecture.map((f) => (
              <li class="flex gap-3">
                <span class="mt-[0.6rem] h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
                <span>{f}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="lg:col-span-5">
      {
        hasMedia ? (
          <img
            src={p.media.src}
            alt={p.media.alt}
            loading="lazy"
            decoding="async"
            class="w-full rounded-lg border border-line"
          />
        ) : (
          <div class="flex aspect-[4/3] w-full flex-col items-center justify-center gap-2 rounded-lg border border-dashed border-line-strong bg-surface p-6 text-center">
            <p class="text-sm font-medium">Captura pendiente</p>
            <p class="font-mono text-xs text-muted">
              Agrega public{p.media.src}
            </p>
          </div>
        )
      }
    </div>
  </div>
</Section>
