      </>
    )
  }
  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {
    name === 'arrow-down' && (
      <>
        <path d="M12 5v14" />
        <path d="m6.5 13.5 5.5 5.5 5.5-5.5" />
      </>
