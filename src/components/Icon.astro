  }
  {
    name === 'phone' && (
      <path d="M5 4h3.5l1.5 4-2 1.5a11 11 0 0 0 6.5 6.5L16 14l4 1.5V19a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z" />
    )
  }
  {
    name === 'download' && (
      <>
        <path d="M12 4v11" />
        <path d="m7.5 10.5 4.5 4.5 4.5-4.5" />
        <path d="M5 19.5h14" />
      </>
    )
  }
  {
    name === 'sun' && (
      <>
        <circle cx="12" cy="12" r="4" />
