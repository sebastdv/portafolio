---
// Diagrama de arquitectura de citara: horizontal en escritorio, vertical en móvil.
// Al entrar en pantalla, el recorrido del mensaje se ilumina una sola vez.
import { profile } from '../data/profile';

const nodes = Object.fromEntries(profile.featured.diagram.nodes.map((n) => [n.id, n]));
type Id = keyof typeof nodes & string;

// Paso de cada nodo en el recorrido (define el orden de la animación).
const step: Record<string, number> = {
  whatsapp: 0,
  webhook: 1,
  queue: 2,
  workers: 3,
  agent: 4,
  calendar: 4,
  db: 5,
};
const STEP_MS = 380;

interface Box {
  id: Id;
  x: number;
  y: number;
  w: number;
  h: number;
}
interface Edge {
  d: string;
  head: string;
  from: Id;
}

/* ---------- Escritorio ---------- */
const DW = 146;
const DH = 72;
const GAP = 44;
const MID = 130;
const col = (i: number) => i * (DW + GAP);
const desktopBoxes: Box[] = [
  { id: 'whatsapp', x: col(0), y: MID - DH / 2, w: DW, h: DH },
  { id: 'webhook', x: col(1), y: MID - DH / 2, w: DW, h: DH },
  { id: 'queue', x: col(2), y: MID - DH / 2, w: DW, h: DH },
  { id: 'workers', x: col(3), y: MID - DH / 2, w: DW, h: DH },
  { id: 'agent', x: col(4), y: 70 - DH / 2, w: DW, h: DH },
  { id: 'calendar', x: col(4), y: 190 - DH / 2, w: DW, h: DH },
  { id: 'db', x: col(5), y: MID - DH / 2, w: DW, h: DH },
];
const right = (x: number, y: number) => `M${x - 6} ${y - 4.5} L${x} ${y} L${x - 6} ${y + 4.5}`;
const hEdge = (from: Id, x1: number, y1: number, x2: number, y2: number): Edge => {
  const mx = (x1 + x2) / 2;
  const d = y1 === y2 ? `M${x1} ${y1} H${x2 - 1}` : `M${x1} ${y1} C${mx} ${y1} ${mx} ${y2} ${x2 - 1} ${y2}`;
  return { d, head: right(x2 - 1, y2), from };
};
const dEnd = (i: number) => col(i) + DW;
const desktopEdges: Edge[] = [
  hEdge('whatsapp', dEnd(0), MID, col(1), MID),
  hEdge('webhook', dEnd(1), MID, col(2), MID),
  hEdge('queue', dEnd(2), MID, col(3), MID),
  hEdge('workers', dEnd(3), MID, col(4), 70),
  hEdge('workers', dEnd(3), MID, col(4), 190),
  hEdge('agent', dEnd(4), 70, col(5), MID),
  hEdge('calendar', dEnd(4), 190, col(5), MID),
];
const desktopW = col(5) + DW;
const desktopH = 236;

/* ---------- Móvil ---------- */
const MW = 320;
const BW = 204;
const BH = 60;
const ROW = 92;
const row = (r: number) => 4 + r * ROW;
const cx = MW / 2;
const SW = 148;
const leftCx = SW / 2;
const rightCx = MW - SW / 2;
const mobileBoxes: Box[] = [
  { id: 'whatsapp', x: cx - BW / 2, y: row(0), w: BW, h: BH },
  { id: 'webhook', x: cx - BW / 2, y: row(1), w: BW, h: BH },
  { id: 'queue', x: cx - BW / 2, y: row(2), w: BW, h: BH },
  { id: 'workers', x: cx - BW / 2, y: row(3), w: BW, h: BH },
  { id: 'agent', x: 0, y: row(4), w: SW, h: BH },
  { id: 'calendar', x: MW - SW, y: row(4), w: SW, h: BH },
  { id: 'db', x: cx - BW / 2, y: row(5), w: BW, h: BH },
];
const down = (x: number, y: number) => `M${x - 4.5} ${y - 6} L${x} ${y} L${x + 4.5} ${y - 6}`;
const vEdge = (from: Id, x1: number, y1: number, x2: number, y2: number): Edge => {
  const my = (y1 + y2) / 2;
  const d = x1 === x2 ? `M${x1} ${y1} V${y2 - 1}` : `M${x1} ${y1} C${x1} ${my} ${x2} ${my} ${x2} ${y2 - 1}`;
  return { d, head: down(x2, y2 - 1), from };
};
const mobileEdges: Edge[] = [
  vEdge('whatsapp', cx, row(0) + BH, cx, row(1)),
  vEdge('webhook', cx, row(1) + BH, cx, row(2)),
  vEdge('queue', cx, row(2) + BH, cx, row(3)),
  vEdge('workers', cx, row(3) + BH, leftCx, row(4)),
  vEdge('workers', cx, row(3) + BH, rightCx, row(4)),
  vEdge('agent', leftCx, row(4) + BH, cx, row(5)),
  vEdge('calendar', rightCx, row(4) + BH, cx, row(5)),
];
const mobileH = row(5) + BH + 4;

const delay = (id: string) => `--d:${step[id] * STEP_MS}ms`;

const layouts = [
  { key: 'desktop', w: desktopW, h: desktopH, boxes: desktopBoxes, edges: desktopEdges, cls: 'hidden lg:block' },
  { key: 'mobile', w: MW, h: mobileH, boxes: mobileBoxes, edges: mobileEdges, cls: 'block lg:hidden mx-auto max-w-[22rem]' },
];

const ordered = profile.featured.diagram.nodes;
---

<figure class="arch" data-arch>
  <div class="dot-grid rounded-lg border border-line bg-surface/60 px-4 py-8 sm:px-8 sm:py-10">
    {
      layouts.map((l) => (
        <svg
          viewBox={`-2 -2 ${l.w + 4} ${l.h + 4}`}
          class:list={['h-auto w-full', l.cls]}
          aria-hidden="true"
          focusable="false"
        >
          <g class="edges" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            {l.edges.map((e) => (
              <g style={delay(e.from)}>
                <path class="edge-base" d={e.d} />
                <path class="edge-trace" d={e.d} pathLength="1" />
                <path class="edge-head" d={e.head} />
              </g>
            ))}
          </g>
          {l.boxes.map((b) => (
            <g class="node" style={delay(b.id)}>
              <rect class="node-box" x={b.x} y={b.y} width={b.w} height={b.h} rx="7" />
              <text
                class="node-title"
                x={b.x + b.w / 2}
                y={b.y + b.h / 2 - 3}
                text-anchor="middle"
              >
                {nodes[b.id].title}
              </text>
              <text
                class="node-detail"
                x={b.x + b.w / 2}
                y={b.y + b.h / 2 + 15}
                text-anchor="middle"
              >
                {nodes[b.id].detail}
              </text>
            </g>
          ))}
        </svg>
      ))
    }
  </div>
  <ol class="sr-only">
    {ordered.map((n) => <li>{n.title}: {n.detail}</li>)}
  </ol>
  <figcaption class="mt-3 font-mono text-xs text-muted">
    Recorrido de un mensaje: WhatsApp, API de webhooks, colas, workers, agente de IA o Google Calendar, PostgreSQL.
  </figcaption>
</figure>

<style>
  .arch :global(svg) {
    overflow: visible;
  }
  .edge-base {
    stroke: var(--line-strong);
  }
  .edge-trace {
    stroke: var(--accent);
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .edge-head {
    stroke: var(--accent);
  }
  .node-box {
    fill: var(--surface);
    stroke: color-mix(in srgb, var(--accent) 55%, var(--line-strong));
    stroke-width: 1.25;
  }
  .node-title {
    fill: var(--fg);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .node-detail {
    fill: var(--muted);
    font-family: var(--font-mono);
    font-size: 11.5px;
  }

  /* Animación: solo con JS y sin preferencia de movimiento reducido.
     Sin JS o con movimiento reducido se ve el estado final, estático. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .edge-trace {
      stroke-dashoffset: 1;
    }
    :global(.js) .edge-head {
      opacity: 0;
    }
    :global(.js) .node-box {
      stroke: var(--line-strong);
    }

    :global(.js) .arch.is-run .edge-trace {
      animation: trace 380ms linear forwards;
      animation-delay: var(--d);
    }
    :global(.js) .arch.is-run .edge-head {
      animation: show 120ms linear forwards;
      animation-delay: calc(var(--d) + 340ms);
    }
    :global(.js) .arch.is-run .node-box {
      animation: light 320ms ease-out forwards;
      animation-delay: var(--d);
    }
  }

  @keyframes trace {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes show {
    to {
      opacity: 1;
    }
  }
  @keyframes light {
    0% {
      stroke: var(--line-strong);
      fill: var(--surface);
    }
    40% {
      stroke: var(--accent);
      fill: var(--accent-soft);
    }
    100% {
      stroke: color-mix(in srgb, var(--accent) 55%, var(--line-strong));
      fill: var(--surface);
    }
  }
</style>

<script>
  const figs = document.querySelectorAll<HTMLElement>('[data-arch]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-run');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.45 },
    );
    figs.forEach((f) => io.observe(f));
  } else {
    figs.forEach((f) => f.classList.add('is-run'));
  }
</script>
