---
// Sección con el título en una columna izquierda (fija al hacer scroll en escritorio)
// y el contenido a la derecha. En móvil y tablet todo va en una columna.
interface Props {
  id: string;
  title: string;
  lead?: string;
  /** Título arriba y contenido a todo el ancho (para la sección destacada). */
  wide?: boolean;
  class?: string;
}

const { id, title, lead, wide = false, class: className } = Astro.props;
const headingId = `${id}-titulo`;
---

<section id={id} aria-labelledby={headingId} class:list={['border-t border-line py-20 sm:py-28', className]}>
  <div class:list={['container-page grid gap-10 lg:gap-8', !wide && 'lg:grid-cols-12']}>
    <header class:list={[!wide && 'lg:col-span-3']}>
      <div class:list={[!wide && 'lg:sticky lg:top-28']}>
        <slot name="eyebrow" />
        <h2
          id={headingId}
          class:list={[
            'font-semibold tracking-[-0.02em]',
            wide ? 'text-4xl sm:text-5xl lg:text-6xl tracking-[-0.035em]' : 'text-2xl sm:text-3xl',
          ]}
        >
          {title}
        </h2>
        {lead && <p class="mt-3 max-w-[44ch] text-[0.9375rem] text-muted">{lead}</p>}
      </div>
    </header>
    <div class:list={['reveal min-w-0', !wide && 'lg:col-span-9']}>
      <slot />
    </div>
  </div>
</section>
